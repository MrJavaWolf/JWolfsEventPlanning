@page
@model IndexModel
@{
    ViewData["Title"] = "JWolfs Event Invitation Generator";
}

<style>
    .title-input {
        flex: 1 1 auto;
        min-width: 0;
        background: transparent;
        border: none;
        border-bottom: 2px solid #0dcaf0;
        color: #0dcaf0;
        font-size: inherit;
        font-weight: inherit;
        font-family: inherit;
        line-height: inherit;
        padding: 0 0.25rem;
        margin: 0;
        height: 1em;
        outline: none;
    }

    .title-input::placeholder {
        color: rgba(13, 202, 240, 0.5);
    }


</style>
<div class="mb-3"><br /></div>
<div class="container">

    <!-- HEADER -->
    <div class="mb-4">
        <h1 class="text-info mb-0 d-flex align-items-center gap-3 text-nowrap">
            <span>
                Invitation for
            </span>
            <input type="text"
                   class="title-input"
                   id="titleInput"
                   placeholder="Furry Movie Night..." />
        </h1>

    </div>

    <div class="row g-4">

        <!-- INPUTS -->
        <div class="col-lg-6">
            <div class="card bg-dark text-light shadow-lg border-secondary rounded-4">
                <div class="card-body p-4">

                    <h2 class="mb-4 text-info">Invitation details</h2>

                    <!-- TITLE STYLE -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Title Style
                        </label>

                        <select class="form-select bg-black text-light border-secondary"
                                id="titleStyleSelect">

                            <option value="simple">Simple</option>
                            <option value="ascii">ASCII</option>
                            <option value="box">Box</option>
                            <option value="double">Double Line</option>
                            <option value="star">Stars</option>

                        </select>
                    </div>


                    <!-- WHERE -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Where</label>

                        <input type="text"
                               class="form-control form-control-lg bg-black text-light border-secondary mb-3"
                               id="whereInput"
                               placeholder="Enter address or venue name..." />

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="useMapsToggle"
                                   checked />

                            <label class="form-check-label"
                                   for="useMapsToggle">
                                Automatically generate Google Maps link
                            </label>
                        </div>

                        <!-- CUSTOM LINK -->
                        <div id="customLinkContainer"
                             style="display:none;">

                            <label class="form-label fw-semibold">
                                Custom Link
                            </label>

                            <input type="text"
                                   class="form-control bg-black text-light border-secondary"
                                   id="customLinkInput"
                                   placeholder="https://example.com" />
                        </div>
                    </div>

                    <!-- COST -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Cost per person
                        </label>

                        <input type="text"
                               class="form-control bg-black text-light border-secondary"
                               id="costInput"
                               placeholder="Example: 50 DKK" />
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               id="lowMoneyToggle">

                        <label class="form-check-label"
                               for="lowMoneyToggle">
                            Write to me if you are low on money
                        </label>
                    </div>

                    <!-- OPTIONS -->
                    <div class="mb-4">
                        <h5 class="text-info mb-3">Event Options</h5>

                        <div id="eventOptionsContainer"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- OUTPUT -->
        <div class="col-lg-6">
            <div class="card bg-dark text-light shadow-lg border-secondary rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0 text-info">Invitation Message</h2>

                        <button class="btn btn-info text-dark fw-bold"
                                type="button"
                                onclick="copyOutput(event)">
                            Copy
                        </button>
                    </div>

                    <textarea id="outputText"
                              class="form-control flex-grow-1 font-monospace bg-black text-success border-secondary"
                              style="min-height:500px;"
                              spellcheck="false"></textarea>

                </div>
            </div>
        </div>

    </div>
</div>

<style>

    body {
        background-color: #0f1115;
        color: #f8f9fa;
    }

    .form-control::placeholder {
        color: #888;
    }

    .form-control:focus,
    .form-select:focus {
        background-color: #000;
        color: #fff;
        border-color: #0dcaf0;
        box-shadow: 0 0 0 0.2rem rgba(13, 202, 240, 0.25);
    }

    textarea {
        resize: none;
    }

    .card {
        backdrop-filter: blur(6px);
    }

</style>

<script>

    const costInput = document.getElementById('costInput');
    const lowMoneyToggle = document.getElementById('lowMoneyToggle');

    const titleInput = document.getElementById('titleInput');
    const titleStyleSelect = document.getElementById('titleStyleSelect');

    const whereInput = document.getElementById('whereInput');
    const useMapsToggle = document.getElementById('useMapsToggle');

    const customLinkContainer = document.getElementById('customLinkContainer');

    const customLinkInput = document.getElementById('customLinkInput');

    const outputText = document.getElementById('outputText');

    // EVENTS
    titleInput.addEventListener('input', updateOutput);
    titleStyleSelect.addEventListener('change', updateOutput);
    costInput.addEventListener('input', updateOutput);

    lowMoneyToggle.addEventListener('change', updateOutput);
    whereInput.addEventListener('input', updateOutput);

    customLinkInput.addEventListener('input', updateOutput);

    useMapsToggle.addEventListener('change', () => {

        customLinkContainer.style.display =
            useMapsToggle.checked ? 'none' : 'block';

        updateOutput();
    });

    const eventOptions = [
        { id: "bringOwnDrinksToggle", text: "Bring your own drinks/alcohol" },
        { id: "bringOwnSodaToggle", text: "Bring your own soda/energi drinks/cocio" },
        { id: "bringSnacksToggle", text: "Bring your own snacks" },
        { id: "foodProvidedToggle", text: "Food will be provided" },
        { id: "dessertProvidedToggle", text: "Dessert will be provided" },
        { id: "sleepoverToggle", text: "Sleepover available" },
        { id: "fursuitFriendlyToggle", text: "Fursuits are welcome" },
        { id: "limitedSpotsToggle", text: "Limited spots available" },
        { id: "adultsOnlyToggle", text: "Adults only (18+)" },
        { id: "plusOneToggle", text: "Plus one or more allowed" },];

    const eventOptionsContainer = document.getElementById("eventOptionsContainer");

    function renderEventOptions() {

        eventOptionsContainer.innerHTML = "";

        eventOptions.forEach(option => {

            eventOptionsContainer.insertAdjacentHTML("beforeend", `
                <div class="form-check form-switch mb-2">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="${option.id}">
                    <label class="form-check-label" for="${option.id}">
                        ${option.text}
                    </label>
                </div>
            `);
        });

        // Hook up change events
        eventOptions.forEach(option => {
            document
                .getElementById(option.id)
                .addEventListener("change", updateOutput);
        });
    }

    // GOOGLE MAPS
    function buildGoogleMapsLink(location) {

        if (!location)
            return '';

        return 'https://www.google.com/maps/search/?api=1&query='
            + encodeURIComponent(location);
    }

    // TITLE BUILDER
    function buildTitle(title) {

        if (!title)
            return 'INSERT_TITLE';

        const style = titleStyleSelect.value;

        switch (style) {

            case 'ascii':
                return buildAsciiTitle(title);

            case 'box':
                return buildBoxTitle(title);

            case 'double':
                return buildDoubleTitle(title);

            case 'star':
                return buildStarTitle(title);

            default:
                return `---- ${title} ----`;
        }
    }

    // ASCII
    function buildAsciiTitle(title) {

        const text = ` ${title.toUpperCase()} `;
        const border = '='.repeat(text.length);

        return `${border}\n${text}\n${border}`;
    }

    // BOX
    function buildBoxTitle(title) {

        const text = ` ${title.toUpperCase()} `;
        const border =
            '+' + '-'.repeat(text.length) + '+';

        return `${border}\n|${text}|\n${border}`;
    }

    // DOUBLE
    function buildDoubleTitle(title) {

        const text = ` ${title.toUpperCase()} `;
        const border = '═'.repeat(text.length);

        return `╔${border}╗\n║${text}║\n╚${border}╝`;
    }

    // STARS
    function buildStarTitle(title) {

        const text = ` ${title.toUpperCase()} `;
        const border = '*'.repeat(text.length);

        return `${border}\n${text}\n${border}`;
    }


    // OUTPUT GENERATOR
    function updateOutput() {

        const title = titleInput.value.trim();
        const where = whereInput.value.trim();

        let locationLink = '';

        if (useMapsToggle.checked) {

            locationLink = buildGoogleMapsLink(where);

        } else {

            locationLink = customLinkInput.value.trim();
        }

        let message = '';

        // TITLE
        const formattedTitle = buildTitle(title);

        message += `${formattedTitle}\n\n`;

        message += `INSERT_FANZY_DESCRIPTION\n\n`;
        message += `When: \n`;

        
        if (where) {

            message += `Where: ${where}\n`;

            if (locationLink) {

                message += `${locationLink}\n`;
            }

            message += '\n';
        }

        // COST
        const cost = costInput.value.trim();

        if (cost) {
            message += `Cost: ${cost} dkk per creature\n`;
        }

        if (lowMoneyToggle.checked) {
            message += `Too expensiv? We still want you to join, text me :3 \n`;
        }

        if (cost || lowMoneyToggle.checked) {
            message += '\n';
        }

        const enabledOptions = eventOptions
            .filter(option => document.getElementById(option.id).checked)
            .map(option => `• ${option.text}`);

        if (enabledOptions.length > 0) {
            message += "Things to know:\n";
            message += enabledOptions.join("\n");
            message += "\n\n";
        }


        outputText.value = message;
    }

    // COPY
    async function copyOutput(event) {

        if (!navigator.clipboard) {
            alert("Clipboard API not available. ensure you are using HTTPS://");
            return;
        }

        await navigator.clipboard.writeText(
            outputText.value
        );

        const button = event.target;
        const originalText = button.innerText;
        button.innerText = 'Copied!';
        setTimeout(() => {
            button.innerText = originalText;
        }, 1500);
    }

    // INITIAL RENDER
    renderEventOptions();
    updateOutput();

</script>